# MedNavigator AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─────────────────────────────────────────
# NVIDIA API Configuration
# ─────────────────────────────────────────

# Your NVIDIA Build API key (get one at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Main chat model: DeepSeek v3.2 for conversational medical AI
NVIDIA_MODEL=deepseek-ai/deepseek-v3.2

# NVIDIA OpenAI-compatible base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Enable extended thinking mode for DeepSeek (true/false)
NVIDIA_ENABLE_THINKING=true

# ─────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────

# Timeout for AI requests in milliseconds
# Use 8000 on Vercel hobby plan (10s hard limit), 25000 on Pro plan
AI_TIMEOUT_MS=8000

# ─────────────────────────────────────────
# Notes
# ─────────────────────────────────────────
# - NVIDIA_API_KEY must be kept server-side only. Never expose to the client.
# - If NVIDIA_API_KEY is not set, the app will return mock/fallback responses.
# - All AI calls are routed through /app/api/ai/route.ts on the server.
