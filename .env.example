# MedNavigator AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─────────────────────────────────────────
# NVIDIA API Configuration
# ─────────────────────────────────────────

# Your NVIDIA Build API key (get one at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA-hosted OpenAI-compatible model ID
NVIDIA_MODEL=z-ai/glm4.7

# NVIDIA OpenAI-compatible base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Enable extended thinking mode for GLM4.7 (true/false)
NVIDIA_ENABLE_THINKING=true

# ─────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────

# Timeout for AI requests in milliseconds (default: 30000 = 30s)
AI_TIMEOUT_MS=30000

# ─────────────────────────────────────────
# Notes
# ─────────────────────────────────────────
# - NVIDIA_API_KEY must be kept server-side only. Never expose to the client.
# - If NVIDIA_API_KEY is not set, the app will return mock/fallback responses.
# - All AI calls are routed through /app/api/ai/route.ts on the server.
